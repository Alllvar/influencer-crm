{
  "name": "influencer-crm",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w client",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write \"{server,client}/src/**/*.{ts,tsx}\" \"server/tests/**/*.ts\"",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
