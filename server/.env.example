NODE_ENV=development
PORT=4000
# Leave empty to use a temporary in-memory MongoDB in development.
# For a real database, paste a MongoDB Atlas connection string here.
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; development falls back to built-in dev secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# "true" seeds demo data into an empty database on start (public demo).
SEED_DEMO=false
